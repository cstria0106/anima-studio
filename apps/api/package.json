{
  "name": "@anima/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap=external",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@anima/runtime": "workspace:*",
    "@anima/shared": "workspace:*",
    "@anima/tag-data": "workspace:*",
    "@anima/workflow": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.10.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "drizzle-kit": "^0.31.7",
    "typescript": "^5.9.3"
  }
}
