API_PORT=8787
DATA_DIR=./data
RUNTIME_DIR=./data/runtime
API_ORIGIN=http://127.0.0.1:8787

# Leave COMFY_URL unset for a new managed installation.
# Set it before the first start to use an existing external ComfyUI.
# External mode never installs, starts, stops, or modifies that process.
# COMFY_URL=http://127.0.0.1:8188

# Managed ComfyUI v1 supports Windows x64 + NVIDIA only.
# Models are not bundled. Do not store a Civitai token in this file; configure
# it through the write-only Library setting so Windows DPAPI protects it.
# MANAGED_RUNTIME_MIN_FREE_BYTES=26843545600
# MANAGED_RUNTIME_START_TIMEOUT_MS=120000
# MANAGED_RUNTIME_STOP_TIMEOUT_MS=15000
# MANAGED_RUNTIME_PORT_START=8188
# MANAGED_RUNTIME_PORT_END=8199

# Optional overrides; repository-managed Danbooru CSVs are used by default.
# DANBOORU_TAGS_CSV=./packages/tag-data/data/danbooru_tags.csv
# DANBOORU_COOCCURRENCE_CSV=./packages/tag-data/data/danbooru_tags_cooccurrence.csv
# DANBOORU_TAG_DATA_MANIFEST=./packages/tag-data/data/manifest.json
# DANBOORU_COOCCURRENCE_MIN_COUNT=5000
