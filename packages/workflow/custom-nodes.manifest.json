{
  "schemaVersion": 1,
  "workflow": "portable-anima-instant-reference",
  "packages": [
    {
      "id": "comfyui",
      "name": "ComfyUI",
      "builtIn": true,
      "installUrl": "https://github.com/Comfy-Org/ComfyUI",
      "nodes": [
        {
          "classType": "UNETLoader",
          "requiredInputs": ["unet_name", "weight_dtype"],
          "outputs": ["MODEL"]
        },
        {
          "classType": "CLIPLoader",
          "requiredInputs": ["clip_name", "type", "device"],
          "outputs": ["CLIP"]
        },
        {
          "classType": "VAELoader",
          "requiredInputs": ["vae_name"],
          "outputs": ["VAE"]
        },
        {
          "classType": "LoraLoader",
          "requiredInputs": [
            "model",
            "clip",
            "lora_name",
            "strength_model",
            "strength_clip"
          ],
          "outputs": ["MODEL", "CLIP"]
        },
        {
          "classType": "LoadImage",
          "requiredInputs": ["image"],
          "outputs": ["IMAGE", "MASK"]
        },
        {
          "classType": "ImageBatch",
          "requiredInputs": ["image1", "image2"],
          "outputs": ["IMAGE"]
        },
        {
          "classType": "CLIPTextEncode",
          "requiredInputs": ["text", "clip"],
          "outputs": ["CONDITIONING"]
        },
        {
          "classType": "RandomNoise",
          "requiredInputs": ["noise_seed"],
          "outputs": ["NOISE"]
        },
        {
          "classType": "KSamplerSelect",
          "requiredInputs": ["sampler_name"],
          "outputs": ["SAMPLER"]
        },
        {
          "classType": "BasicScheduler",
          "requiredInputs": ["model", "scheduler", "steps", "denoise"],
          "outputs": ["SIGMAS"]
        },
        {
          "classType": "EmptyLatentImage",
          "requiredInputs": ["width", "height", "batch_size"],
          "outputs": ["LATENT"]
        },
        {
          "classType": "SamplerCustomAdvanced",
          "requiredInputs": ["noise", "guider", "sampler", "sigmas", "latent_image"],
          "outputs": ["LATENT", "LATENT"]
        },
        {
          "classType": "VAEDecode",
          "requiredInputs": ["samples", "vae"],
          "outputs": ["IMAGE"]
        },
        {
          "classType": "VAEEncode",
          "requiredInputs": ["pixels", "vae"],
          "outputs": ["LATENT"]
        },
        {
          "classType": "VAEEncodeForInpaint",
          "requiredInputs": ["pixels", "vae", "mask", "grow_mask_by"],
          "outputs": ["LATENT"],
          "feature": "inpaint"
        },
        {
          "classType": "RepeatLatentBatch",
          "requiredInputs": ["samples", "amount"],
          "outputs": ["LATENT"],
          "feature": "inpaint"
        },
        {
          "classType": "RepeatImageBatch",
          "requiredInputs": ["image", "amount"],
          "outputs": ["IMAGE"],
          "feature": "inpaint"
        },
        {
          "classType": "ImageCompositeMasked",
          "requiredInputs": [
            "destination",
            "source",
            "x",
            "y",
            "resize_source"
          ],
          "optionalInputs": ["mask"],
          "outputs": ["IMAGE"],
          "feature": "inpaint"
        },
        {
          "classType": "SaveImage",
          "requiredInputs": ["filename_prefix", "images"],
          "outputs": []
        },
        {
          "classType": "SaveText",
          "requiredInputs": ["text", "filename_prefix", "format"],
          "outputs": ["STRING"]
        },
        {
          "classType": "LatentUpscaleBy",
          "requiredInputs": ["samples", "upscale_method", "scale_by"],
          "outputs": ["LATENT"]
        }
      ]
    },
    {
      "id": "instant-reference",
      "name": "ComfyUI Instant Reference",
      "builtIn": false,
      "installUrl": "https://github.com/cstria0106/comfyui-instant-reference",
      "nodes": [
        {
          "classType": "ReferenceTrainOptions",
          "requiredInputs": [
            "steps_override",
            "learning_rate_override",
            "network_dim_override",
            "network_alpha_override",
            "resolution_override",
            "gradient_checkpointing",
            "cache_latents",
            "cache_text_encoder_outputs",
            "seed_override",
            "force_retrain",
            "train_batch_size_override"
          ],
          "outputs": ["TRAIN_OPTIONS"]
        },
        {
          "classType": "ReferenceTaggingOptions",
          "requiredInputs": [
            "general_threshold",
            "character_threshold",
            "prepend_tags",
            "append_tags",
            "exclude_tags",
            "replace_tags",
            "remove_underscore"
          ],
          "outputs": ["TAGGING_OPTIONS"]
        },
        {
          "classType": "InstantReferenceLoRA",
          "requiredInputs": [
            "model",
            "clip",
            "images",
            "model_strength",
            "clip_strength",
            "profile"
          ],
          "optionalInputs": ["vae", "tagging_options", "train_options"],
          "outputs": ["MODEL", "CLIP", "STRING", "LORA_STACK", "STRING"]
        }
      ]
    },
    {
      "id": "lora-optimizer",
      "name": "ComfyUI LoRA Optimizer",
      "builtIn": false,
      "installUrl": "https://github.com/ethanfel/ComfyUI-LoRA-Optimizer",
      "nodes": [
        {
          "classType": "LoRAStackDynamic",
          "requiredInputs": [
            "settings_visibility",
            "input_mode",
            "lora_count",
            "lora_name_1",
            "lora_name_text_1",
            "strength_1",
            "model_strength_1",
            "clip_strength_1",
            "conflict_mode_1",
            "key_filter_1",
            "lora_name_2",
            "lora_name_text_2",
            "strength_2",
            "model_strength_2",
            "clip_strength_2",
            "conflict_mode_2",
            "key_filter_2",
            "lora_name_3",
            "lora_name_text_3",
            "strength_3",
            "model_strength_3",
            "clip_strength_3",
            "conflict_mode_3",
            "key_filter_3",
            "lora_name_4",
            "lora_name_text_4",
            "strength_4",
            "model_strength_4",
            "clip_strength_4",
            "conflict_mode_4",
            "key_filter_4",
            "lora_name_5",
            "lora_name_text_5",
            "strength_5",
            "model_strength_5",
            "clip_strength_5",
            "conflict_mode_5",
            "key_filter_5",
            "lora_name_6",
            "lora_name_text_6",
            "strength_6",
            "model_strength_6",
            "clip_strength_6",
            "conflict_mode_6",
            "key_filter_6",
            "lora_name_7",
            "lora_name_text_7",
            "strength_7",
            "model_strength_7",
            "clip_strength_7",
            "conflict_mode_7",
            "key_filter_7",
            "lora_name_8",
            "lora_name_text_8",
            "strength_8",
            "model_strength_8",
            "clip_strength_8",
            "conflict_mode_8",
            "key_filter_8",
            "lora_name_9",
            "lora_name_text_9",
            "strength_9",
            "model_strength_9",
            "clip_strength_9",
            "conflict_mode_9",
            "key_filter_9",
            "lora_name_10",
            "lora_name_text_10",
            "strength_10",
            "model_strength_10",
            "clip_strength_10",
            "conflict_mode_10",
            "key_filter_10"
          ],
          "optionalInputs": ["lora_stack", "base_model_filter"],
          "outputs": ["LORA_STACK"]
        },
        {
          "classType": "LoRAOptimizerSimple",
          "requiredInputs": ["model", "lora_stack", "output_strength"],
          "optionalInputs": ["clip", "clip_strength_multiplier"],
          "outputs": ["MODEL", "CLIP"]
        }
      ]
    },
    {
      "id": "kjnodes",
      "name": "ComfyUI KJNodes",
      "builtIn": false,
      "installUrl": "https://github.com/kijai/ComfyUI-KJNodes",
      "nodes": [
        {
          "classType": "ScheduledCFGGuidance",
          "requiredInputs": [
            "model",
            "positive",
            "negative",
            "cfg",
            "start_percent",
            "end_percent"
          ],
          "outputs": ["GUIDER"]
        }
      ]
    }
  ]
}
